ut.map(lambda l: l.split(\",\")).cache()\n\n# Cancelados: columna 22 → índice 21\ncancel = parsed.filter(lambda l: l[21] == '1')\n\n# Redirigidos: columna 24 → índice 23\nredir = parsed.filter(lambda l: l[23] == '1')\n\nnCancel = cancel.count()\nnRedir = redir.count()\n\nprint(\"cancelados = {}%\".format(float(nCancel) * 100 / nTotal))\nprint(\"redireccionados = {}%\".format(float(nRedir) * 100 / nTotal))\n\n","user":"anonymous","dateUpdated":"2025-09-23T12:57:25-0300","progress":0,"config":{"colWidth":12,"fontSize":12,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"cancelados = 1.142%\nredireccionados = 0.16%\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.64.138.36:4040/jobs/job?id=28"},{"jobUrl":"http://10.64.138.36:4040/jobs/job?id=29"},{"jobUrl":"http://10.64.138.36:4040/jobs/job?id=30"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1758642937440_1252584328","id":"paragraph_1758642937440_1252584328","dateCreated":"2025-09-23T12:55:37-0300","dateStarted":"2025-09-23T12:57:25-0300","dateFinished":"2025-09-23T12:57:34-0300","status":"FINISHED"},{"title":"Ejercicio","text":"%md\nLa columna 14 del mismo archivo tiene el tiempo del vuelo en minutos. Calcular el máximo.\n\n#### Ayuda\n\n* Busque en la documentacion de la [API RDD](https://spark.apache.org/docs/3.4.3/api/python/reference/pyspark.html#rdd-apis) una acción para calcular el máximo.\n* Ojo que puede haber valores no definidos.\n","user":"anonymous","dateUpdated":"2025-09-06T10:31:34-0300","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","editorHide":true,"fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<p>La columna 14 del mismo archivo tiene el tiempo del vuelo en minutos. Calcular el máximo.</p>\n<h4>Ayuda</h4>\n<ul>\n<li>Busque en la documentacion de la <a href=\"https://spark.apache.org/docs/3.4.3/api/python/reference/pyspark.html#rdd-apis\">API RDD</a> una acción para calcular el máximo.</li>\n<li>Ojo que puede haber valores no definidos.</li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757165494242_158464371","id":"20171016-232257_285172371","dateCreated":"2025-09-06T10:31:34-0300","status":"READY"},{"text":"%pyspark\n# Ejercicio resuelto\ninput = sc.textFile(\"/home/usuario/diplodatos_bigdata/ds/flights.csv\")\n\n# Separar columnas y cachear\nparsed = input.map(lambda l: l.split(\",\")).cache()\n\n# Filtrar header (primera fila) y valores vacíos en la columna 14\nflight_times = parsed \\\n    .filter(lambda l: l[13] != \"ActualElapsedTime\" and l[13] != \"\") \\\n    .map(lambda l: float(l[13]))\n\n# Acción: máximo\nmax_time = flight_times.max()\n\nprint(\"El tiempo máximo de vuelo es: {} minutos\".format(max_time))\n","user":"anonymous","dateUpdated":"2025-09-23T12:59:26-0300","progress":0,"config":{"colWidth":12,"fontSize":12,"results":{},"enabled":true,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"results":{"code":"ERROR","msg":[{"type":"TEXT","data":"Py4JJavaError: An error occurred while calling z:org.apache.spark.api.python.PythonRDD.collectAndServe.\n: org.apache.spark.SparkException: Job aborted due to stage failure: Task 1 in stage 56.0 failed 1 times, most recent failure: Lost task 1.0 in stage 56.0 (TID 224) (10.64.138.36 executor driver): org.apache.spark.api.python.PythonException: Traceback (most recent 